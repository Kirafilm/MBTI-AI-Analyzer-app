# =============================================================================
# MBTI AI Analyzer — 環境變數範本
# =============================================================================
#
# 使用方式：
#   1. 複製此檔案：  cp .env.example .env
#   2. 填入真實值（勿將 .env 提交到 Git）
#
# 變數說明：
#   - EXPO_PUBLIC_*  會打包進客戶端（網頁 / App），只可放公開金鑰
#   - 無前綴變數       僅伺服器使用，切勿暴露
#
# 本地開發最低需求：
#   - EXPO_PUBLIC_SUPABASE_URL
#   - EXPO_PUBLIC_SUPABASE_ANON_KEY
#   其餘可留空，相關功能會優雅降級
# =============================================================================


# -----------------------------------------------------------------------------
# 伺服器（後端 API）
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# 網頁版連接後端用。本地開發可留空（會自動用 localhost:3000）
# 正式環境例：https://api.yourdomain.com
EXPO_PUBLIC_API_BASE_URL=

# Session 簽章（Manus OAuth 用；使用 Supabase 登入可留空）
JWT_SECRET=change-me-to-a-long-random-string

# Manus OAuth（選填；未設定則僅用 Supabase 登入）
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=


# -----------------------------------------------------------------------------
# 資料庫（選填；Stripe 購買記錄、OAuth 用戶同步）
# -----------------------------------------------------------------------------
# 例：mysql://user:password@localhost:3306/mbti_analyzer
DATABASE_URL=

# 伺服器驗證 Supabase JWT 時可與下方 URL 相同
SUPABASE_URL=


# -----------------------------------------------------------------------------
# Supabase 認證（建議填寫）
# -----------------------------------------------------------------------------
# Supabase 後台 → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# -----------------------------------------------------------------------------
# AI 分析（選填；未設定則 MBTI AI 分析功能不可用）
# -----------------------------------------------------------------------------
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# NVIDIA NIM (build.nvidia.com) — OpenAI-compatible free endpoint
# Get a key: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Optional model (default: meta/llama-3.1-8b-instruct)
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Force a provider when multiple keys exist: nvidia | openrouter | forge
# LLM_PROVIDER=nvidia

# OpenRouter (many free models via openrouter/free)
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional model override (default: openrouter/free)
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_SITE_URL=https://mbti.hyphenjob.com
# OPENROUTER_SITE_NAME=MBTI AI Analyzer


# -----------------------------------------------------------------------------
# Stripe — 網頁版進階解鎖付款
# -----------------------------------------------------------------------------
# Stripe 後台 → Developers → API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Stripe 後台 → Products → 建立一次性 Price 後複製 Price ID
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxxxxx

# Stripe 後台 → Webhooks → 端點 /api/stripe/webhook
# 本地測試：stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# 網頁顯示價格（Stripe 未連線時的後備顯示）
EXPO_PUBLIC_STRIPE_PRICE_LABEL=HK$18


# -----------------------------------------------------------------------------
# RevenueCat — iOS / Android 應用內購買（網頁版不用）
# -----------------------------------------------------------------------------
EXPO_PUBLIC_RC_IOS_API_KEY=appl_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_WEB_API_KEY=
EXPO_PUBLIC_RC_PREMIUM_ENTITLEMENT_ID=psychology_premium
EXPO_PUBLIC_RC_OFFERING_ID=default


# -----------------------------------------------------------------------------
# Adsterra — 網頁版廣告
# -----------------------------------------------------------------------------
# Smartlink (preferred when iframe banners stay blank)
# EXPO_PUBLIC_ADSTERRA_SMARTLINK_URL=https://accuracyinstalled.com/uz92t45si?key=2e796aa2215bca4d870f6fe4dc0a63cc
# Optional iframe unit keys (fallback)
# EXPO_PUBLIC_ADSTERRA_BANNER_728_KEY=38293ea339dba5bc588c2356bbff619a
# EXPO_PUBLIC_ADSTERRA_BANNER_320_KEY=b3d0ea80c672306a3bef624296f3d0cd
# EXPO_PUBLIC_ADSTERRA_DISPLAY_300_KEY=8d72c5b0abf0b964506f69bac341acaf


# -----------------------------------------------------------------------------
# EmailJS — 聯絡我們表單（選填）
# -----------------------------------------------------------------------------
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# 開發用測試登入（正式環境務必關閉）
# -----------------------------------------------------------------------------
EXPO_PUBLIC_ENABLE_TEST_LOGIN=false
EXPO_PUBLIC_TEST_LOGIN_EMAIL=
EXPO_PUBLIC_TEST_LOGIN_PASSWORD=


# -----------------------------------------------------------------------------
# Expo 本地開發（一般無需修改）
# -----------------------------------------------------------------------------
EXPO_PORT=8081
