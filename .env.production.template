# =============================================================================
# MBTI AI Analyzer — 正式環境變數範本
# =============================================================================
#
# 使用方式：
#   1. 複製此檔案：  cp .env.production.template .env.production
#   2. 填入正式環境真實值
#   3. 部署時載入 .env.production（或於主機平台設定同等變數）
#
# 開發環境請用：  cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# 伺服器
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=production

# Cloud Run 部署後的 API 網址（例：https://mbti-api-xxxxx-asia-east1.run.app）
# Cloudflare Pages 建置時也要設同一個值（EXPO_PUBLIC_* 會打包進網頁）
EXPO_PUBLIC_API_BASE_URL=https://mbti-api-xxxxx-asia-east1.run.app
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Manus OAuth（如使用）
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=


# -----------------------------------------------------------------------------
# 資料庫
# -----------------------------------------------------------------------------
DATABASE_URL=mysql://user:password@host:3306/mbti_analyzer
SUPABASE_URL=https://xxxxxxxx.supabase.co


# -----------------------------------------------------------------------------
# Supabase 認證
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# -----------------------------------------------------------------------------
# AI 分析
# -----------------------------------------------------------------------------
# NVIDIA NIM（免費額度，OpenAI 相容）
# https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# LLM_PROVIDER=nvidia

# OpenRouter（推薦，可用免費 model）
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=


# -----------------------------------------------------------------------------
# Stripe — 網頁版付款（使用 sk_live_ / 正式 Webhook）
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_STRIPE_PRICE_LABEL=HK$18


# -----------------------------------------------------------------------------
# RevenueCat — 手機應用內購買
# -----------------------------------------------------------------------------
EXPO_PUBLIC_RC_IOS_API_KEY=appl_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_RC_WEB_API_KEY=
EXPO_PUBLIC_RC_PREMIUM_ENTITLEMENT_ID=psychology_premium
EXPO_PUBLIC_RC_OFFERING_ID=default


# -----------------------------------------------------------------------------
# AdMob — 手機廣告
# -----------------------------------------------------------------------------
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-xxxxxxxx~xxxxxxxx
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-xxxxxxxx~xxxxxxxx
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_UNIT_ID=ca-app-pub-xxxxxxxx/xxxxxxxx
EXPO_PUBLIC_ADMOB_IOS_BANNER_UNIT_ID=ca-app-pub-xxxxxxxx/xxxxxxxx
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_UNIT_ID=ca-app-pub-xxxxxxxx/xxxxxxxx
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_UNIT_ID=ca-app-pub-xxxxxxxx/xxxxxxxx


# -----------------------------------------------------------------------------
# AdSense — 網頁廣告（網站上線並通過審核後啟用）
# -----------------------------------------------------------------------------
# EXPO_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# EXPO_PUBLIC_ADSENSE_BANNER_SLOT=xxxxxxxxxx
# EXPO_PUBLIC_ADSENSE_DISPLAY_SLOT=xxxxxxxxxx


# -----------------------------------------------------------------------------
# EmailJS — 聯絡表單
# -----------------------------------------------------------------------------
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# 測試登入（正式環境必須關閉）
# -----------------------------------------------------------------------------
EXPO_PUBLIC_ENABLE_TEST_LOGIN=false
EXPO_PUBLIC_TEST_LOGIN_EMAIL=
EXPO_PUBLIC_TEST_LOGIN_PASSWORD=
